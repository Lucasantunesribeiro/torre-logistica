# Modelo das variáveis do provisionamento.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# `terraform.tfvars` é ignorado pelo Git. Nada aqui é segredo — a chave PRIVADA nunca entra neste
# arquivo, só a pública —, mas OCID de tenancy e faixa de endereço administrativo são informação
# sobre a sua conta, e não sobre o projeto.

# OCID da conta. Console da Oracle → Perfil → Tenancy.
ocid_da_tenancy = "ocid1.tenancy.oc1..SUBSTITUA"

# Precisa ser a região de ORIGEM (home region) da conta: a capacidade Always Free de Ampere A1 só
# existe nela. O valor abaixo é um exemplo — confirme o seu com:
#
#   oci iam region-subscription list --query 'data[?"is-home-region"].{regiao:"region-name"}'
#
# Console da Oracle → o nome no canto superior direito também mostra.
regiao = "sa-saopaulo-1"

# Perfil dentro de ~/.oci/config.
perfil_da_cli = "DEFAULT"

# Como o perfil acima foi criado:
#   "SecurityToken"  se por `oci session authenticate` (login pelo navegador)
#   "ApiKey"         se por `oci setup config` (par de chaves)
#
# Errar aqui produz uma mensagem sobre chave ausente, que não diz nada sobre o método.
metodo_de_autenticacao = "SecurityToken"

# Opcional. Vazio usa o primeiro domínio de disponibilidade da região.
#
# Vale preencher quando a criação falhar com "Out of host capacity": a recusa costuma ser de um
# domínio específico, e tentar outro resolve. A capacidade gratuita de Ampere A1 é disputada, e
# essa recusa é comum — ela NÃO significa que algo está errado no plano.
dominio_de_disponibilidade = ""

# --- Dimensionamento -------------------------------------------------------
# Os padrões já são os valores medidos e conferidos contra o nível gratuito. Mudar qualquer um
# destes números muda a conta de gratuidade — as validações em `variables.tf` recusam o que passa
# do limite, e a saída `conferencia_de_gratuidade` mostra a conta a cada `apply`.
# 1 OCPU, e nao 2, por CAPACIDADE — nao por cota nem por custo.
#
# A conta permite 2 OCPU de Ampere A1, e 23 tentativas de criar com 2 foram recusadas com
# "Out of host capacity": o pool gratuito de A1 em sa-saopaulo-1 e disputado, e a regiao tem um
# unico dominio de disponibilidade, entao nao ha outro AD para tentar. Pedir menos nucleo amplia
# o conjunto de hosts capazes de atender.
#
# A pilha foi revalidada sob teto real de 1 nucleo compartilhado por todos os conteineres:
# subida em 37 s, as seis historias em 102 s com saida 0, pico de 550 MiB e 54,6%% de um nucleo,
# zero reinicio e zero erro; p50 3,7 ms e p95 5,3 ms nas leituras atraves do Caddy.
#
# Se algum dia a capacidade de 2 OCPU abrir e houver motivo medido para usa-la, basta subir este
# numero — a cota do compartimento acompanha, porque e derivada dele.
ocpus                  = 1
memoria_em_gb          = 4
tamanho_do_disco_em_gb = 50

# --- Acesso ----------------------------------------------------------------
# O conteúdo do arquivo .pub, inteiro, numa linha. Gere o par com:
#   ssh-keygen -t ed25519 -C "torre-logistica-demo"
chave_publica_ssh = "ssh-ed25519 AAAA... SUBSTITUA"

# De onde a porta 22 aceita conexão. Descubra o seu endereço com:
#   curl -s https://checkip.amazonaws.com
#
# Não use 0.0.0.0/0. Funciona, e deixa todo varredor automático da internet batendo na porta.
cidr_de_administracao = "203.0.113.10/32"

# --- Guarda-corpos financeiros ---------------------------------------------
email_do_alerta_de_custo       = "voce@exemplo.com"
limite_do_orcamento_em_dolares = 1

# --- Nomes -----------------------------------------------------------------
prefixo = "torre-demo"
