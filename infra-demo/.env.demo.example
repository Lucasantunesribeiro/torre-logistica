# ---------------------------------------------------------------------------
# Torre Logística — modelo do arquivo de ambiente da DEMONSTRAÇÃO.
#
# Este arquivo é um modelo. O arquivo real NÃO fica no repositório: ele vive na máquina, em
#
#     /etc/torre-logistica/.env.demo     (dono root, permissão 600)
#
# e é apontado no comando:
#
#     docker compose -f infra-demo/docker-compose.demo.yml \
#       --env-file /etc/torre-logistica/.env.demo up -d --build
#
# Todos os campos de segredo estão VAZIOS de propósito. Segredo com valor de exemplo é segredo que
# alguém vai deixar como está.
# ---------------------------------------------------------------------------

# --- Domínios --------------------------------------------------------------
# Os quatro precisam ser subdomínios do MESMO domínio registrável: o cookie de sessão é
# `SameSite=Strict`, e ele só vale entre nomes que o navegador considera do mesmo site.
#
# Os quatro precisam apontar (registro A) para o IP público da máquina ANTES da primeira subida:
# o Caddy pede o certificado no momento em que sobe, e a autoridade certificadora confere o DNS.
#
# Não há valor de exemplo aqui de propósito. Um domínio inventado é o tipo de valor que sobrevive
# ao copiar-e-colar e só aparece quando o certificado falha.
TORRE_DOMINIO_CONSOLE=
TORRE_DOMINIO_MOTORISTA=
TORRE_DOMINIO_RASTREAMENTO=
TORRE_DOMINIO_API=

# Endereço para o qual a autoridade certificadora avisa que o certificado vai expirar.
TORRE_EMAIL_ACME=

# `https` em qualquer ambiente publicado — é o padrão quando a variável não vem.
# `http` existe só para a validação local, onde não há domínio nem certificado.
TORRE_ESQUEMA_PUBLICO=https

# --- Disco persistente -----------------------------------------------------
# Onde ficam os dados que precisam sobreviver a `docker compose down`: o banco e os comprovantes.
TORRE_DIRETORIO_DADOS=/srv/torre-logistica

# --- Banco -----------------------------------------------------------------
TORRE_POSTGRES_BANCO=torre_logistica
TORRE_POSTGRES_USUARIO=torre
# Gere com:  openssl rand -base64 32
TORRE_POSTGRES_SENHA=

# --- Chaves da aplicação ---------------------------------------------------
# Todas em Base64, com pelo menos 32 bytes. Gere cada uma separadamente:
#   openssl rand -base64 48
#
# Separadas de propósito: uma chave única para assinar sessão, assinar URL de comprovante e
# cifrar segredo de webhook faria o vazamento de qualquer uma comprometer as três.
TORRE_CHAVE_DE_TOKEN=
TORRE_CHAVE_DE_ARMAZENAMENTO=
TORRE_CHAVE_DE_WEBHOOKS=

# --- Rede interna do Docker ------------------------------------------------
# De quais endereços a API aceita os cabeçalhos `X-Forwarded-*`. O padrão cobre a faixa que o
# Docker usa para as redes que ele cria. Confirme a sua com:
#
#   docker network inspect torre-logistica-demo_borda --format '{{(index .IPAM.Config 0).Subnet}}'
#
# Aceitar de qualquer origem deixaria qualquer visitante declarar o próprio endereço e escapar do
# limite de tentativas de login. A API recusa subir com o tratamento ligado e esta lista vazia.
TORRE_REDE_DA_BORDA=172.16.0.0/12

# --- Demonstração ----------------------------------------------------------
# A senha COMUM de todo o elenco fictício: as contas semeadas na primeira subida e a conta pela
# qual o botão "Explorar demonstração" abre a sessão do visitante.
#
# Essa conta precisa ser de privilégio mínimo — a API recusa abrir a porta pública se for
# administradora, para um erro de configuração não virar exposição.
#
# Gere com:  openssl rand -base64 24
TORRE_DEMO_ORGANIZACAO=transportadora-aurora
TORRE_DEMO_EMAIL=paula.siqueira@aurora.test
TORRE_DEMO_SENHA=

# Semente do roteiro: a mesma semente conta a mesma história.
TORRE_DEMO_SEMENTE=2026
# Quantas vezes o tempo do roteiro corre mais rápido que o relógio de parede.
TORRE_DEMO_MULTIPLICADOR=60

# --- Retenção --------------------------------------------------------------
# 7 dias na demonstração, contra 30 em produção: o disco da máquina é de 50 GB, e localização bruta
# cresce cerca de 1 GB por dia de operação simulada. Ver `docs/adr/0029`.
TORRE_RETENCAO_DE_POSICOES=7.00:00:00

# --- Mapa ------------------------------------------------------------------
# Vazio de propósito: sem provedor de tiles, o Mapa da Operação desenha os pontos sobre fundo
# neutro e não depende de nenhuma conta contratada. Padrão embutido é conta que alguém paga sem
# saber — e esta demonstração tem custo recorrente de US$ 0,00.
TORRE_URL_DO_ESTILO_DO_MAPA=
