{
  "name": "torre-logistica",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace das aplicacoes web da Torre Logistica",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:operacao": "npm run dev --workspace @torre/operacao",
    "dev:motorista": "npm run dev --workspace @torre/motorista",
    "dev:rastreamento": "npm run dev --workspace @torre/rastreamento",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint .",
    "verificar": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
