# ---------------------------------------------------------------------------
# Torre Logística — arquivos que nunca entram no repositório
# ---------------------------------------------------------------------------

# Build .NET
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user
*.suo
*.userprefs
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
TestResults/
coverage/
*.coverage
*.trx

# Node / frontend
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
.eslintcache
vitest-report/
playwright-report/

# Ambiente e segredos — nunca versionar
.env
.env.*
!.env.example
# Modelo do ambiente da demonstração. Só nomes de variáveis; todo campo de segredo vem vazio.
!.env.demo.example
*.pem
*.key
*.pfx
appsettings.Local.json
appsettings.*.Local.json
secrets.json

# Terraform — estado, plano e variáveis preenchidas
# O estado guarda, em texto claro, tudo o que o provedor devolveu. O plano binário guarda o mesmo.
# `*.tfvars` é onde as credenciais reais são escritas; só o `.example` é versionado.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.auto.tfvars
*.tfvars
!*.tfvars.example

# Sistema operacional
Thumbs.db
Desktop.ini
.DS_Store

# Ferramentas locais
*.log
.docker-data/

# agent skills config (local, seeded from ~/.agents/mattpocock-config)
docs/agents/

# Saída das validações locais da pilha da demonstração (medições, logs, amostras).
infra-demo/.saida-validacao/
