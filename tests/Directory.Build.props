<Project>

  <!-- Herda a configuração da raiz e acrescenta o que é comum a projetos de teste. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!--
      xunit.v3 roda sobre o Microsoft.Testing.Platform. O SDK do .NET 10 removeu o
      caminho antigo (VSTest); a escolha do runner está em `global.json`, na seção
      "test". Por isso os pacotes de runner do VSTest não entram aqui.
    -->
    <TestingPlatformCaptureOutput>true</TestingPlatformCaptureOutput>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
