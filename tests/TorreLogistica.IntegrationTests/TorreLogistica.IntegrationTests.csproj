<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TorreLogistica.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TorreLogistica.Api/TorreLogistica.Api.csproj" />
    <ProjectReference Include="../../src/TorreLogistica.Infrastructure/TorreLogistica.Infrastructure.csproj" />
    <!--
      O simulador entra aqui como objeto de teste, não como dependência da aplicação: a seta continua
      apontando de fora para dentro. É o que permite encenar a demonstração contra a API em memória e
      provar que o roteiro é reproduzível, sem subir processo nem servidor.
    -->
    <ProjectReference Include="../../src/TorreLogistica.Simulator/TorreLogistica.Simulator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers.Azurite" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

</Project>
