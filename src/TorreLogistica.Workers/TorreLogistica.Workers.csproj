<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Composition root para cargas assíncronas (outbox, webhooks, projeções).
    Na Fase 0 o host existe, valida as dependências críticas na inicialização
    e não registra nenhum job — jobs chegam nas fases que os definem.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TorreLogistica.Workers</RootNamespace>
    <UserSecretsId>torre-logistica-workers</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TorreLogistica.Application\TorreLogistica.Application.csproj" />
    <ProjectReference Include="..\TorreLogistica.Infrastructure\TorreLogistica.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

</Project>
