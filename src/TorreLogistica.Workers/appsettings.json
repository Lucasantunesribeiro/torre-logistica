{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Torre": {
    "BancoDeDados": {
      "CadeiaDeConexao": "",
      "TimeoutDeComandoEmSegundos": 30,
      "TentativasEmFalhaTransitoria": 3,
      "AplicarMigrationsAoIniciar": false
    }
  }
}
