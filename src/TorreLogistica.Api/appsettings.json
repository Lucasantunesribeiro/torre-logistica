{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Torre": {
    "BancoDeDados": {
      "CadeiaDeConexao": "",
      "TimeoutDeComandoEmSegundos": 30,
      "TentativasEmFalhaTransitoria": 3,
      "AplicarMigrationsAoIniciar": false
    },
    "Cors": {
      "OrigensPermitidas": []
    },
    "Autenticacao": {
      "DuracaoDoTokenDeAcesso": "00:15:00",
      "DuracaoDaSessaoNoConsole": "12:00:00",
      "DuracaoDaSessaoNoAplicativoDoMotorista": "7.00:00:00",
      "JanelaDeToleranciaDaRenovacao": "00:00:20",
      "LimiteDeFalhasDeLogin": 5,
      "DuracaoDoBloqueio": "00:15:00"
    },
    "TokenDeAcesso": {
      "Emissor": "torre-logistica",
      "ChaveDeAssinatura": ""
    },
    "LimiteDeRequisicoes": {
      "TentativasDeLoginPorMinuto": 10,
      "RenovacoesPorMinuto": 30
    }
  },
  "AllowedHosts": "*"
}
