{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Torre": {
    "BancoDeDados": {
      "CadeiaDeConexao": "",
      "TimeoutDeComandoEmSegundos": 30,
      "TentativasEmFalhaTransitoria": 3,
      "AplicarMigrationsAoIniciar": false
    },
    "Cors": {
      "OrigensPermitidas": []
    },
    "ProxyReverso": {
      "Habilitado": false,
      "RedesConfiaveis": [],
      "ProxiesConfiaveis": [],
      "LimiteDeSaltos": 1
    },
    "Autenticacao": {
      "DuracaoDoTokenDeAcesso": "00:15:00",
      "DuracaoDaSessaoNoConsole": "12:00:00",
      "DuracaoDaSessaoNoAplicativoDoMotorista": "7.00:00:00",
      "JanelaDeToleranciaDaRenovacao": "00:00:20",
      "LimiteDeFalhasDeLogin": 5,
      "DuracaoDoBloqueio": "00:15:00"
    },
    "TokenDeAcesso": {
      "Emissor": "torre-logistica",
      "ChaveDeAssinatura": ""
    },
    "LimiteDeRequisicoes": {
      "TentativasDeLoginPorMinuto": 10,
      "RenovacoesPorMinuto": 30,
      "EnviosDePosicaoPorMinuto": 60,
      "SincronizacoesPorMinuto": 30,
      "ConsultasPublicasPorMinuto": 30,
      "RequisicoesDeIntegracaoPorMinuto": 120
    },
    "Previsao": {
      "Provedor": "simulado",
      "TempoMedioPorParada": "00:05:00",
      "FolgaParaAtencao": "00:20:00",
      "FolgaParaRisco": "00:05:00",
      "MudancaRelevanteDaChegadaPrevista": "00:02:00",
      "TempoLimiteDoProvedor": "00:00:03",
      "VelocidadeDeContingenciaEmMetrosPorSegundo": 6,
      "FatorDeSinuosidadeDeContingencia": 1.4,
      "IntervaloDeReavaliacao": "00:01:00",
      "IntervaloMinimoEntreRecalculosPorPosicao": "00:00:30",
      "ProvedorSimulado": {
        "VelocidadeMediaEmMetrosPorSegundo": 8.5,
        "FatorDeSinuosidade": 1.3
      }
    },
    "Armazenamento": {
      "Diretorio": "",
      "EnderecoBase": "http://localhost:5080",
      "ChaveDeAssinatura": "",
      "ValidadeDaUrlDeEnvio": "00:10:00",
      "ValidadeDaUrlDeLeitura": "00:05:00"
    },
    "Comprovantes": {
      "ExigirNaConclusao": false,
      "ExigirArquivo": true
    },
    "RastreamentoPublico": {
      "ValidadeEmDias": 30,
      "ExporComprovante": true
    },
    "Webhooks": {
      "ChaveDeCriptografia": "",
      "IntervaloDeDespacho": "00:00:05",
      "IntervaloDeEntrega": "00:00:05",
      "PermitirDestinoLocal": false,
      "ProcessarEmSegundoPlano": true,
      "TempoLimite": "00:00:10"
    },
    "Alertas": {
      "TempoSemPosicaoParaOffline": "00:10:00",
      "TempoParadoParaAlerta": "00:15:00",
      "TempoParadoAtendendoParadaParaAlerta": "00:30:00",
      "RaioDeImobilidadeEmMetros": 100,
      "LimiteDeTentativas": 2,
      "JanelaDeReabertura": "00:30:00"
    }
  },
  "AllowedHosts": "*"
}
