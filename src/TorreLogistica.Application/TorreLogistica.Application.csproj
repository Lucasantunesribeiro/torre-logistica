<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Casos de uso e orquestração.
    Depende do domínio e apenas de abstrações de plataforma (DI e logging).
  -->

  <PropertyGroup>
    <RootNamespace>TorreLogistica.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TorreLogistica.Domain\TorreLogistica.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Só o núcleo do EF Core: DbSet, LINQ e ExecuteUpdate. Nunca Relational nem Npgsql.
         Ver docs/adr/0008-application-usa-ef-core-sem-repositorio.md. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
