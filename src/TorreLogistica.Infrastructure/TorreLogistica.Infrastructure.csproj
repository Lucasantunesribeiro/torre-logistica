<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Adaptadores concretos: PostgreSQL/PostGIS, relógio, geração de identificador,
    health checks de dependência.
  -->

  <PropertyGroup>
    <RootNamespace>TorreLogistica.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Detalhe interno do adaptador de storage exercitado diretamente pelos testes: derivação do
         endereço do serviço e nome do metadado do resumo. Não faz parte da superfície pública. -->
    <InternalsVisibleTo Include="TorreLogistica.UnitTests" />
    <InternalsVisibleTo Include="TorreLogistica.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TorreLogistica.Application\TorreLogistica.Application.csproj" />
    <ProjectReference Include="..\TorreLogistica.Domain\TorreLogistica.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Blob Storage dos comprovantes e identidade gerenciada. A fronteira Azure para de aqui:
         nenhum tipo do SDK atravessa IObjectStorage. -->
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- IHttpClientFactory para a entrega de webhooks: cliente reaproveitado, sem esgotar socket nem
         congelar DNS. Versão já fixada centralmente e usada pelo simulador. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Tipos geography/geometry do PostGIS. Fica só aqui: o domínio usa CoordenadaGeografica. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
