# ---------------------------------------------------------------------------
# Torre Logística — modelo de variáveis de ambiente para desenvolvimento local.
#
# Copie este arquivo para `.env` e preencha com valores LOCAIS.
# `.env` é ignorado pelo Git e nunca deve conter credencial de ambiente real.
#
#   cp .env.example .env
#
# Em produção nada disso vem de arquivo: os valores saem de um gerenciador de
# segredos e chegam ao processo como variáveis de ambiente.
# ---------------------------------------------------------------------------

# --- Contêiner do PostgreSQL/PostGIS (docker-compose.yml) -------------------
TORRE_POSTGRES_BANCO=torre_logistica
TORRE_POSTGRES_USUARIO=torre
TORRE_POSTGRES_SENHA=troque_esta_senha_local
# 55432 evita conflito com uma instalação nativa do PostgreSQL na 5432.
TORRE_POSTGRES_PORTA=55432

# --- Aplicações .NET --------------------------------------------------------
# O separador `__` (dois sublinhados) é como a configuração do .NET representa
# hierarquia: `Torre__BancoDeDados__CadeiaDeConexao` alimenta a seção
# `Torre:BancoDeDados:CadeiaDeConexao`.
Torre__BancoDeDados__CadeiaDeConexao=Host=localhost;Port=55432;Database=torre_logistica;Username=torre;Password=troque_esta_senha_local

# Chave HMAC (Base64, >= 32 bytes) que assina os tokens de acesso. Obrigatória fora
# de Development/Testing. Gere uma local com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
Torre__TokenDeAcesso__ChaveDeAssinatura=

# Semeadura local: duas organizações fictícias com contas de cada perfil.
# Só vale em Development. A senha comum das contas vem daqui, nunca do repositório.
Torre__Desenvolvimento__Semeadura__Habilitada=false
Torre__Desenvolvimento__Semeadura__SenhaInicial=troque_esta_senha_local

# Endereço base da API usado pelo simulador.
Torre__Simulador__UrlBaseDaApi=http://localhost:5080

# Senha das contas da demonstração. Vazia de propósito: o simulador recusa começar sem ela,
# em vez de tentar uma senha adivinhada. Em desenvolvimento, é a mesma de
# Torre__Desenvolvimento__Semeadura__SenhaInicial.
Torre__Simulador__Senha=

# --- Demonstração pública ----------------------------------------------------
# Desligada por padrão. Ligada, o console mostra "Explorar demonstração" e o servidor
# abre a sessão pelo visitante — ele nunca recebe a senha.
# A conta precisa ser de privilégio mínimo: o servidor recusa abrir a porta se for
# administradora, para um erro de configuração não virar exposição.
Torre__Demonstracao__Habilitada=false
Torre__Demonstracao__Organizacao=transportadora-aurora
Torre__Demonstracao__Email=paula.siqueira@aurora.test
Torre__Demonstracao__Senha=

# Semente do roteiro: a mesma semente conta a mesma história.
Torre__Simulador__Semente=2026

# Quantas vezes o tempo do roteiro corre mais rápido que o relógio de parede.
Torre__Simulador__MultiplicadorDeTempo=60

# Coletor OpenTelemetry (OTLP). Vazio de propósito: sem endereço, os instrumentos continuam
# funcionando e nada sai do processo — ninguém precisa subir coletor para rodar o projeto.
# O protocolo é aberto: trocar de ferramenta é trocar este endereço.
Torre__Observabilidade__EnderecoOtlp=

# Proporção de rastros amostrados, de 0 a 1. A telemetria de GPS é intensa; em produção o
# volume total pode custar mais que o problema que ele ajudaria a achar.
Torre__Observabilidade__ProporcaoDeAmostragem=1

# Retenção do histórico bruto de localização. Piso de um dia.
Torre__Retencao__PosicoesBrutas=30.00:00:00

# --- Aplicações web (Vite) --------------------------------------------------
# Somente variáveis com o prefixo VITE_ chegam ao navegador. Nunca coloque
# segredo aqui: tudo o que tem esse prefixo é embutido no pacote publicado.
VITE_URL_DA_API=http://localhost:5080

# Estilo do mapa do console, do provedor que a implantação escolher.
# Vazio de propósito: sem ele o Mapa da Operação desenha os pontos sobre fundo neutro, e o
# console funciona sem depender de contratar fornecedor de tiles. Não há padrão embutido —
# padrão embutido é conta que alguém paga sem saber.
VITE_URL_DO_ESTILO_DO_MAPA=
